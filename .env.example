# Copy this file to ".env" and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config).
# These values are not secret (your data is protected by firestore.rules), so .env may be committed.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: your own web address for customer links (default: https://<project-id>.web.app)
# EXPO_PUBLIC_SHARE_URL=https://plots.yourdomain.com

# Developers only: use the local Firebase emulators instead of the real project
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
