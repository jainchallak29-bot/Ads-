# Copy this file to ".env" and fill in what you need. Only the Meta app lines are needed to start.
# (Lines starting with # are ignored.)

# ---------------------------------------------------------------------------
# 1. Your Meta (Facebook) app — from https://developers.facebook.com/apps
#    App settings → Basic → "App ID" and "App secret". See README step 2.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

# Optional: "Facebook Login for Business" configuration ID. Only needed if the
# login popup complains about permissions/scopes. See README "Troubleshooting".
META_LOGIN_CONFIG_ID=

# Optional: Graph API version (default v27.0, the newest when this app was written).
# META_GRAPH_VERSION=v27.0

# ---------------------------------------------------------------------------
# 2. Instagram PHOTO posts (Reels and all Facebook posts work without this)
#    Instagram downloads photos from a public web address. Choose ONE option:
# ---------------------------------------------------------------------------
# a) Free imgbb.com key (easiest when running on your own computer):
#    get one at https://api.imgbb.com/ — photos are deleted again after 1 hour.
IMGBB_API_KEY=

# b) The public https address of this app (when it runs online or behind a tunnel).
#    Detected automatically on Render, Railway and Fly.io. Requires APP_PASSWORD.
# PUBLIC_BASE_URL=https://my-poster.example.com

# ---------------------------------------------------------------------------
# 3. Security — REQUIRED whenever the app can be reached from other computers
#    (PUBLIC_BASE_URL set, or HOST=0.0.0.0). Anyone with it can post to your Pages.
# ---------------------------------------------------------------------------
APP_PASSWORD=

# ---------------------------------------------------------------------------
# 4. Server
# ---------------------------------------------------------------------------
PORT=3000
# HOST=127.0.0.1          # use 0.0.0.0 inside Docker / on a server (needs APP_PASSWORD)
# DATA_DIR=./data         # tokens, history and uploads are stored here
# MAX_UPLOAD_MB=1024
# MEDIA_RETENTION_DAYS=7  # uploaded files are deleted after this many days

# Optional: path to ffmpeg/ffprobe if they are not on your PATH (used to fix videos for Instagram/Reels).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Print every Meta API request (without tokens) to the console.
# DEBUG=true
