{
  "name": "social-poster",
  "version": "1.0.0",
  "description": "Post images and videos to Facebook Pages, Instagram (posts & Reels) and Facebook Groups from one screen, with your own caption and hashtags.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
