rules_version = '2';

// Security rules for the Plot Inventory app.
// Every phone signs in anonymously. A phone gets access to a project only by
// entering one of the project's codes:
//   - Admin code → can do everything (edit plots & shapes, see codes, remove members)
//   - Sales code → can view; can mark plots booked/sold only if the admin allows it
// Deploy with:  firebase deploy --only firestore:rules   (or paste into the Firebase console)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function projectPath(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function memberPath(pid) { return /databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid); }
    function codePath(code) { return /databases/$(database)/documents/joinCodes/$(code); }

    function isMember(pid) { return signedIn() && exists(memberPath(pid)); }
    function role(pid) { return get(memberPath(pid)).data.role; }
    function isAdmin(pid) { return isMember(pid) && role(pid) == 'admin'; }
    function isSales(pid) { return isMember(pid) && role(pid) == 'sales'; }
    function salesMayEdit(pid) { return isSales(pid) && get(projectPath(pid)).data.salesCanEdit == true; }
    function canEditStatus(pid) { return isAdmin(pid) || salesMayEdit(pid); }
    function approvalOn(pid) { return get(projectPath(pid)).data.get('features', {}).get('approval', false) == true; }
    function saleStage(s) { return s in ['available', 'token', 'booked', 'agreement', 'sold']; }

    // A code is valid for a project/role if the joinCodes document says so
    // (getAfter: also works in the same batch that creates the project).
    function validCode(pid, code, r) {
      return code is string
        && getAfter(codePath(code)).data.projectId == pid
        && getAfter(codePath(code)).data.role == r;
    }

    // ---- join codes: can be looked up by someone who knows the code, never listed
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['projectId', 'role', 'createdAt'])
        && request.resource.data.role in ['admin', 'sales']
        && (
          // an existing admin adds a new code
          isAdmin(request.resource.data.projectId)
          // or the project is being created in this same batch by me
          || (!exists(projectPath(request.resource.data.projectId))
              && getAfter(projectPath(request.resource.data.projectId)).data.ownerUid == request.auth.uid)
        );
      allow update: if false;
      allow delete: if isAdmin(resource.data.projectId);
    }

    // ---- customer share link: readable by anyone who has the (unguessable) link
    function pubPath(token) { return /databases/$(database)/documents/publicLayouts/$(token); }
    match /publicLayouts/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin(request.resource.data.projectId);
      allow update: if (isAdmin(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId)
        // team members who may change statuses keep "Available / Not available" current
        || (canEditStatus(resource.data.projectId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'stAt']));
      allow delete: if isAdmin(resource.data.projectId);
      match /chunks/{chunk} {
        allow read: if true;
        allow create, update: if isAdmin(getAfter(pubPath(token)).data.projectId);
        allow delete: if isAdmin(get(pubPath(token)).data.projectId);
      }
    }

    match /projects/{pid} {
      allow get: if isMember(pid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.salesCanEdit is bool;
      allow update: if isAdmin(pid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin(pid);

      match /members/{uid} {
        allow read: if isMember(pid);
        // join / re-join with a valid code; the role must match the code
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'name', 'code', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && validCode(pid, request.resource.data.code, request.resource.data.role);
        // admins remove people; anyone can leave
        allow delete: if isAdmin(pid) || (signedIn() && request.auth.uid == uid);
      }

      match /private/{docId} {
        allow read, write: if isAdmin(pid);
      }

      match /plots/{plotId} {
        allow read: if isMember(pid);
        allow create, delete: if isAdmin(pid);
        allow update: if isAdmin(pid)
          // Sales change the status directly (no approval needed)
          || (salesMayEdit(pid) && !approvalOn(pid)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'soldBy', 'buyerName', 'buyerPhone', 'bookingDate', 'notes', 'updatedAt', 'updatedBy', 'updatedByName'])
              // Sales can't use or undo "Not for sale" (blocked)
              && saleStage(request.resource.data.status)
              && resource.data.status != 'blocked'
              && request.resource.data.updatedBy == request.auth.uid)
          // Approval on: Sales only file / cancel their own request; the status itself stays
          || (salesMayEdit(pid) && approvalOn(pid)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['pending', 'buyerName', 'buyerPhone', 'bookingDate', 'notes', 'updatedAt', 'updatedBy', 'updatedByName'])
              && resource.data.status != 'blocked'
              && request.resource.data.updatedBy == request.auth.uid
              && (resource.data.get('pending', null) == null || resource.data.pending.by == request.auth.uid)
              && (request.resource.data.get('pending', null) == null
                  || (request.resource.data.pending.by == request.auth.uid && saleStage(request.resource.data.pending.status))));
      }

      // Money: payments, instalments, commission, brokers — admins only
      match /accounts/{plotId} {
        allow read, write: if isAdmin(pid);
      }
      match /brokers/{brokerId} {
        allow read, write: if isAdmin(pid);
      }

      match /layout/{chunk} {
        allow read: if isMember(pid);
        allow write: if isAdmin(pid);
      }

      match /activity/{id} {
        allow read: if isMember(pid);
        allow create: if canEditStatus(pid) && request.resource.data.by == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin(pid);
      }
    }
  }
}
